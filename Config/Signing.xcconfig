// Code signing. Ad-hoc by default, so anyone can build without an Apple account.
//
// Ad-hoc builds get a new identity on every build, so macOS asks again for
// Keychain access after each rebuild. To sign with your own certificate, copy
// Signing.local.xcconfig.example to Signing.local.xcconfig (gitignored) and fill it in.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
