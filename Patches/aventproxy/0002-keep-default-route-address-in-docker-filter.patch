--- a/pkg/xnet/net_test.go	1970-01-01 01:00:00
+++ b/pkg/xnet/net_test.go	2026-11-20 23:17:14
@@ -0,0 +1,31 @@
+package xnet
+
+import (
+	"net"
+	"testing"
+)
+
+func TestDockerFilterKeepsDefaultRouteAddress(t *testing.T) {
+	hotspot := net.ParseIP("172.20.10.6").To4()
+	filter := DockerFilter(hotspot)
+
+	if !filter(hotspot) {
+		t.Errorf("the default route address %s was filtered out", hotspot)
+	}
+	if filter(net.ParseIP("172.17.0.1").To4()) {
+		t.Error("docker0 address was kept")
+	}
+	if !filter(net.ParseIP("192.168.1.10").To4()) {
+		t.Error("LAN address was filtered out")
+	}
+}
+
+func TestDockerFilterWithoutDefaultRoute(t *testing.T) {
+	filter := DockerFilter(nil)
+	if filter(net.ParseIP("172.20.10.6").To4()) {
+		t.Error("Docker-range address kept with no default route")
+	}
+	if !filter(net.ParseIP("10.0.0.2").To4()) {
+		t.Error("non-Docker address filtered out")
+	}
+}
