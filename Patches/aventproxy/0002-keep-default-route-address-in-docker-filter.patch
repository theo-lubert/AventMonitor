--- a/pkg/xnet/net.go	2026-11-20 23:17:01
+++ b/pkg/xnet/net.go	2026-11-20 23:17:14
@@ -17,6 +17,28 @@
 	Mask: []byte{255, 240, 0, 0},
 }
 
+// DockerFilter returns an IP filter that drops Docker-like addresses, except
+// keep, the address of the host's default route (nil keeps none).
+func DockerFilter(keep net.IP) func(ip net.IP) bool {
+	return func(ip net.IP) bool {
+		return !Docker.Contains(ip) || (keep != nil && ip.Equal(keep))
+	}
+}
+
+// DefaultRouteIP returns the local IPv4 address the host uses to reach the
+// internet, or nil. Connecting a UDP socket only picks a route: no packet is sent.
+func DefaultRouteIP() net.IP {
+	conn, err := net.Dial("udp4", "192.0.2.1:9") // TEST-NET-1, never contacted
+	if err != nil {
+		return nil
+	}
+	defer conn.Close()
+	if addr, ok := conn.LocalAddr().(*net.UDPAddr); ok {
+		return addr.IP.To4()
+	}
+	return nil
+}
